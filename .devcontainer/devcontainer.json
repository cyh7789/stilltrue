{
  "name": "StillTrue",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "pip install -e . && echo 'Run: make codespace-demo'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "forwardPorts": [8080, 9002],
  "portsAttributes": {
    "9002": { "label": "DataHub UI", "onAutoForward": "notify" },
    "8080": { "label": "DataHub GMS", "onAutoForward": "silent" }
  }
}
