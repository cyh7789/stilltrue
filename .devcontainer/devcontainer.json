{
  "name": "StillTrue",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "pip install -e . && echo 'Ready. Run: make demo-from-cold'",
  "forwardPorts": [8080, 9002],
  "portsAttributes": {
    "9002": { "label": "DataHub UI", "onAutoForward": "notify" },
    "8080": { "label": "DataHub GMS", "onAutoForward": "silent" }
  }
}
